# Application
APP_NAME="Legal CMS"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Database
POSTGRES_USER=legal_cms
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legal_cms

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=INFO

# OpenAI (Sprint 2 - AI Intake)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# Intake agent
INTAKE_MIN_ANSWERS=4

# Document storage (Sprint 3)
STORAGE_BACKEND=local           # "local" | "s3"
LOCAL_STORAGE_DIR=./storage/documents
MAX_UPLOAD_MB=25

# AWS S3 (used when STORAGE_BACKEND=s3)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
