# Application
APP_NAME="Legal CMS"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Database
POSTGRES_USER=legal_cms
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legal_cms

# JWT
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_generated_64_char_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP (registration OTP emails). Leave SMTP_HOST blank to log codes to the
# console instead of sending real emails (useful for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Registration OTP
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Logging
LOG_LEVEL=INFO

# OpenAI (Sprint 2 - AI Intake)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# Intake agent
INTAKE_MIN_ANSWERS=4

# Document storage (Sprint 3)
STORAGE_BACKEND=local           # "local" | "s3"
LOCAL_STORAGE_DIR=./storage/documents
MAX_UPLOAD_MB=25

# AWS S3 (used when STORAGE_BACKEND=s3)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
